# ============================================================
md-agent-bootstrap/src/main/resources/application.yml
md-agent-bootstrap/src/main/resources/application-*.yml
md-agent-bootstrap/src/main/resources/k8s/md-agent-platform-cm.yaml
md-agent-bootstrap/src/main/resources/k8s/md-agent-platform-secret.yaml
.env
.env.*
*.local

